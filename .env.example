# Agente Analítico de Vendas — variáveis de ambiente. Copie para .env (NÃO versionado): cp .env.example .env

# ---- Postgres ----
POSTGRES_DB=workshop
POSTGRES_USER=workshop
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_PORT=5432

# ---- nginx (reverse proxy: única porta exposta ao host) ----
NGINX_PORT=8080
# App em:  http://localhost:8080/health  ·  POST http://localhost:8080/chat

# ---- Conexão admin (RW) usada por host tools: Alembic, seed ----
# Aponta pro Postgres exposto em localhost. No container, o compose injeta host=postgres.
DATABASE_URL=postgresql+asyncpg://workshop:troque-esta-senha@localhost:5432/workshop

# ---- Papel somente-leitura do agente — criado pela migration 0001 (uv run alembic upgrade head) ----
AGENTE_RO_PASSWORD=troque-esta-senha-ro
# Conexão RO usada pela API rodando no host. No container, o compose monta a URL com host=postgres.
DATABASE_URL_RO=postgresql+asyncpg://agente_ro:troque-esta-senha-ro@localhost:5432/workshop

# ---- Papel que grava os runs do agente (schema harness) — migration 0003 ----
HARNESS_RW_PASSWORD=troque-esta-senha-harness
DATABASE_URL_HARNESS=postgresql+asyncpg://harness_rw:troque-esta-senha-harness@localhost:5432/workshop

# ---- LLM dos nós (agnóstico de provedor). Sem modelo/chave, o /chat responde 503. ----
# openai usa OPENAI_API_KEY (a mesma dos embeddings); anthropic usa ANTHROPIC_API_KEY.
LLM_PROVIDER=openai
# Defaults no código (workshop original): forte=gpt-4o, rapido=gpt-4o-mini. Descomente p/ trocar.
# LLM_MODEL_FORTE=gpt-4o          # redige o relatório
# LLM_MODEL_RAPIDO=gpt-4o-mini    # extrai a intenção da pergunta
# LLM_ESFORCO_FORTE=medium     # opcional: reasoning_effort (OpenAI) / effort (Anthropic)
# LLM_ESFORCO_RAPIDO=low
# ANTHROPIC_API_KEY=sk-ant-troque-esta-chave

# ---- Qdrant (vetorial: 3 coleções camada_semantica/diagnostico/prescricao) ----
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_URL=http://localhost:6333

# ---- MinIO (object store: corpus bruto). Defaults locais; troque em produção. ----
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=localhost:9000
MINIO_BUCKET=corpus
MINIO_BUCKET_RELATORIOS=relatorios   # relatórios do agente; a API cria no startup se faltar

# ---- Embeddings (OpenAI) — usados na ingestão (seed/ingest.py) ----
OPENAI_API_KEY=sk-troque-esta-chave        # obrigatório para a ingestão
EMBED_MODEL=text-embedding-3-large
EMBED_DIM=3072
