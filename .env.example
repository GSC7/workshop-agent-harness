# Agente Analítico de Vendas — variáveis de ambiente. Copie para .env (NÃO versionado): cp .env.example .env

# ---- Postgres ----
POSTGRES_DB=workshop
POSTGRES_USER=workshop
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_PORT=5432

# ---- nginx (reverse proxy: única porta exposta ao host) ----
NGINX_PORT=8080
# App em:  http://localhost:8080/health  ·  POST http://localhost:8080/chat

# ---- Conexão admin (RW) usada por host tools: Alembic, seed ----
# Aponta pro Postgres exposto em localhost. No container, o compose injeta host=postgres.
DATABASE_URL=postgresql+asyncpg://workshop:troque-esta-senha@localhost:5432/workshop

# ---- Papel somente-leitura do agente — criado pela migration 0001 (uv run alembic upgrade head) ----
AGENTE_RO_PASSWORD=troque-esta-senha-ro
# Conexão RO usada pela API rodando no host. No container, o compose monta a URL com host=postgres.
DATABASE_URL_RO=postgresql+asyncpg://agente_ro:troque-esta-senha-ro@localhost:5432/workshop

# ---- Papel que grava os runs do agente (schema harness) — migration 0003 ----
HARNESS_RW_PASSWORD=troque-esta-senha-harness
DATABASE_URL_HARNESS=postgresql+asyncpg://harness_rw:troque-esta-senha-harness@localhost:5432/workshop

# ---- LLM dos nós (agnóstico de provedor). Sem modelo/chave, o /chat responde 503. ----
# openai usa OPENAI_API_KEY (a mesma dos embeddings); anthropic usa ANTHROPIC_API_KEY.
LLM_PROVIDER=openai
# Defaults no código (workshop original): forte=gpt-4o, rapido=gpt-4o-mini. Descomente p/ trocar.
# LLM_MODEL_FORTE=gpt-4o          # redige o relatório
# LLM_MODEL_RAPIDO=gpt-4o-mini    # extrai a intenção da pergunta
# LLM_ESFORCO_FORTE=medium     # opcional: reasoning_effort (OpenAI) / effort (Anthropic)
# LLM_ESFORCO_RAPIDO=low
# ANTHROPIC_API_KEY=sk-ant-troque-esta-chave

# ---- Qdrant (vetorial: 3 coleções camada_semantica/diagnostico/prescricao) ----
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_URL=http://localhost:6333

# ---- MinIO (object store: corpus bruto). Defaults locais; troque em produção. ----
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=localhost:9000
MINIO_BUCKET=corpus
MINIO_BUCKET_RELATORIOS=relatorios   # só p/ a api no host; no compose é fixo (o da política do minio-init)
# Senha do usuário da api no MinIO (agente-relatorios, só o bucket relatorios — #26). Obrigatória:
# o minio-init cria o usuário com ela. Gere com `openssl rand -hex 24`. O root acima fica só na
# infra (minio, minio-init) e no host (seed); a api no container nunca o recebe.
# Com o par MINIO_API_* completo, a api no host também usa o usuário restrito; sem ele, o root.
MINIO_API_USER=agente-relatorios
MINIO_API_PASSWORD=

# ---- Embeddings (OpenAI) — usados na ingestão (seed/ingest.py) ----
OPENAI_API_KEY=sk-troque-esta-chave        # obrigatório para a ingestão
EMBED_MODEL=text-embedding-3-large
EMBED_DIM=3072

# ---- Langfuse (observabilidade, #11/#30 — ADR 0014): stack próprio, OPCIONAL ----
# Só sobe com o profile: `docker compose --profile observabilidade up -d`. Para ligar por padrão,
# descomente a linha abaixo (o compose lê COMPOSE_PROFILES do .env).
# COMPOSE_PROFILES=observabilidade
# UI em http://localhost:3000 (pelo nginx, só em 127.0.0.1; sem o profile, 502). Sem o profile,
# estas variáveis podem ficar vazias. Com ele, o langfuse-segredos recusa subir se faltar alguma
# (nada de segredo default). Gere com `openssl rand -hex 32` (hex: sem caractere especial na URL
# do Postgres). As chaves do projeto são criadas no 1º boot (init headless) com estes valores e
# usadas pela api para os traces; sem elas, a api roda sem trace (trace_id nulo). Sem o profile,
# deixe LANGFUSE_PUBLIC_KEY/SECRET_KEY vazias: com chaves e sem Langfuse no ar, o export falha
# (só em log, mas a cada run).
LANGFUSE_PORT=3000
LANGFUSE_PUBLIC_KEY=                         # pk-lf-<hex>
LANGFUSE_SECRET_KEY=                         # sk-lf-<hex>
LANGFUSE_HOST=http://localhost:3000          # api no host; no container o compose usa langfuse-web
LANGFUSE_INIT_USER_EMAIL=admin@exemplo.com
LANGFUSE_INIT_USER_PASSWORD=
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_SALT=
LANGFUSE_ENCRYPTION_KEY=                     # exatamente 64 hex: openssl rand -hex 32
LANGFUSE_PG_PASSWORD=
LANGFUSE_CLICKHOUSE_PASSWORD=
LANGFUSE_REDIS_AUTH=
LANGFUSE_MINIO_PASSWORD=
